{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kintai-craft",
  "version": "1.0.0",
  "identifier": "com.kintai.craft",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:export",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "kintai-craft 出勤簿",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
